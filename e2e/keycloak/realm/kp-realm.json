{
  "realm": "kp",
  "enabled": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "gateway",
      "name": "Gateway (introspection client)",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-only-gateway-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "e2e-cli",
      "name": "E2E test client (password grant)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "librechat",
      "name": "LibreChat (OpenID login, reference overlay T-021 / ADR-018)",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-only-librechat-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3080/oauth/openid/callback"],
      "webOrigins": ["http://localhost:3080"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3080/login",
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "900"
      },
      "protocolMappers": [
        {
          "name": "audience-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "gateway",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "credentials": [
        { "type": "password", "value": "dev-only-alice-password", "temporary": false }
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Example",
      "credentials": [
        { "type": "password", "value": "dev-only-bob-password", "temporary": false }
      ]
    }
  ]
}
