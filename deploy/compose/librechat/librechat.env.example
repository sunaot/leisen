# LibreChat(deploy/compose の LibreChat overlay、T-021)の環境変数の雛形。
#
#   cp librechat/librechat.env.example librechat/librechat.env    # deploy/compose で実行
#
# librechat.env は git 管理外(.gitignore)。docker-compose.librechat.yml が env_file で
# librechat コンテナにだけ渡す。値はすべてローカル評価専用のダミー(dev-only- 接頭辞、または
# 明らかに作り物の 16 進列)。実運用の秘密情報をこの雛形・librechat.yaml・compose ファイルに
# 書かないこと(不変条件6)。各変数の意味は LibreChat の公式ドキュメント(.env、OpenID Connect、
# OpenID Connect Token Reuse)を参照。
#
# 【手元で動かすときは、下の LibreChat 自身の鍵を必ず生成して置き換える】
# JWT_SECRET / JWT_REFRESH_SECRET / CREDS_KEY / OPENID_SESSION_SECRET は openssl rand -hex 32、
# CREDS_IV は openssl rand -hex 16 で生成する(手順は docs/ui-librechat.md §1.2)。雛形の値は
# このリポジトリで公開されているため、そのまま使うと 127.0.0.1:3080 に届く人が LibreChat の
# セッション(JWT)を偽造できる(利用者の ID が分かればその利用者になりすまし、会話履歴 =
# 本人の権限で得た回答を読める)。CREDS_KEY / CREDS_IV は保存時暗号化の鍵で、公開された値の
# ままでは暗号化の意味がない。雛形のまま使うのは CI(reference-deploy。使い捨てのランナー)
# だけ。実運用では各値を秘密ストアから注入する。OPENID_CLIENT_SECRET は realm
# (e2e/keycloak/realm/kp-realm.json)のダミーと対なので、変えるときは Keycloak 側も合わせる。

#---- サーバー ----
# ブラウザから見た URL(compose はループバックだけに公開する)。OpenID のコールバックは
# DOMAIN_SERVER + OPENID_CALLBACK_URL で、Keycloak のクライアント librechat の redirectUris と
# 完全一致させる(realm はワイルドカードを使わない。変えたら realm も合わせる)
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
NO_INDEX=true
# 会話の内容を含みうるデバッグログをファイルに書かない(調査するときだけ true にする)
DEBUG_LOGGING=false

#---- 使える LLM エンドポイント ----
# librechat.yaml の LM Studio(custom)とエージェントだけにする(外部の LLM プロバイダへ
# 社内文書にもとづく回答を送らない評価構成)
ENDPOINTS=custom,agents
# librechat.yaml の LM Studio エンドポイントの apiKey。LM Studio はキーを見ないため、
# 空でない任意の値でよい
LIBRECHAT_LLM_API_KEY=dev-only-lm-studio-ignores-this

#---- 会話の共有 ----
# 共有リンクを作らせない。回答は質問者本人の権限で検索した結果であり、他人に見せると
# ソース側の認可を迂回する(threat-model TM-G4、T-009)
ALLOW_SHARED_LINKS=false

#---- ログイン: Keycloak(realm kp)の OpenID Connect だけ ----
ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_SOCIAL_LOGIN=true
# 初回の OpenID ログインで LibreChat の利用者を作る
ALLOW_SOCIAL_REGISTRATION=true
# 発行者は https(LibreChat の OpenID クライアントは http の発行者を扱えない)。
# docker-compose.librechat.yml の keycloak の KC_HOSTNAME + /realms/kp と一致させる
OPENID_ISSUER=https://keycloak.localhost:8443/realms/kp
OPENID_CLIENT_ID=librechat
# realm(e2e/keycloak/realm/kp-realm.json)のクライアント librechat の secret と一致させる
OPENID_CLIENT_SECRET=dev-only-librechat-secret
OPENID_SESSION_SECRET=dev-only-librechat-openid-session-secret
OPENID_SCOPE="openid profile email"
OPENID_CALLBACK_URL=/oauth/openid/callback
# 認可コードフローに PKCE(S256)を使う。realm のクライアント librechat は PKCE の S256 を
# 必須にしている(pkce.code.challenge.method)。v0.8.7 が使う openid-client 6.5.0 は、この値に
# よらず常に S256 のコードチャレンジを送るが、意図を明示するために true にする
OPENID_USE_PKCE=true
# ログインで得た利用者本人のトークンを保持して再利用する。librechat.yaml の MCP サーバー
# leisen は {{LIBRECHAT_OPENID_ACCESS_TOKEN}} でこのアクセストークンを Orchestrator へ
# 転送する(ADR-018 決定8)。false にすると Orchestrator は 401 を返す
OPENID_REUSE_TOKENS=true
# ログアウトで Keycloak のセッションも終える(alice / bob を切り替えられるように)。
# ログアウト後の戻り先は DOMAIN_CLIENT + /login(OPENID_POST_LOGOUT_REDIRECT_URI の既定)で、
# realm のクライアント librechat の post.logout.redirect.uris と完全一致させる
OPENID_USE_END_SESSION_ENDPOINT=true
OPENID_BUTTON_LABEL=Keycloak でログイン
# true にするとログイン画面を経ずに Keycloak へ直行する(任意)
OPENID_AUTO_REDIRECT=false

#---- LibreChat 自身のセッション・保存時暗号化の鍵(ダミー。手元では生成して置き換える) ----
# 形式は LibreChat の .env.example に従う: JWT_* は任意の文字列、CREDS_KEY は 32 バイト
# (16 進 64 桁)、CREDS_IV は 16 バイト(16 進 32 桁)。OPENID_SESSION_SECRET(上)も同じく
# 生成する。生成: openssl rand -hex 32(CREDS_IV だけ openssl rand -hex 16)
JWT_SECRET=dev-only-librechat-jwt-secret
JWT_REFRESH_SECRET=dev-only-librechat-jwt-refresh-secret
CREDS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CREDS_IV=0123456789abcdef0123456789abcdef
