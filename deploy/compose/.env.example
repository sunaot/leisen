# リファレンスデプロイ(deploy/compose)の環境変数の雛形(T-012)。
#
#   cp .env.example .env
#
# .env は git 管理外(.gitignore)で、docker compose が変数展開のために自動で読む。
# docker-compose.yml は各コンテナに必要な変数だけを渡す。
# 値はすべて e2e/keycloak の realm と揃えたローカル評価専用のダミー(dev-only-)。
# 実運用の秘密情報をこのファイルや deployment.yaml に書かないこと(不変条件6)。

# Gateway がトークンのイントロスペクションに使う Keycloak クライアント gateway の secret。
# realm(e2e/keycloak/realm/kp-realm.json)に書かれた値と一致させる
KP_KEYCLOAK_CLIENT_SECRET=dev-only-gateway-secret

# ソース dev-docs(開発用コネクタ)に渡す本人資格情報のモック(auth.provider: mock_env)
KP_MOCK_TOKEN_DEV_DOCS=dev-only-token

# Keycloak(開発モード)の管理者 admin の初期パスワード
KC_BOOTSTRAP_ADMIN_PASSWORD=dev-only-admin-password
