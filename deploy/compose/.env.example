# リファレンスデプロイ(deploy/compose)の環境変数の雛形(T-012、T-021)。
#
#   cp .env.example .env
#
# .env は git 管理外(.gitignore)で、docker compose が変数展開のために自動で読む。
# docker-compose.yml(と LibreChat overlay の docker-compose.librechat.yml)は各コンテナに
# 必要な変数だけを渡す。秘密の値はすべて e2e/keycloak の realm と揃えたローカル評価専用の
# ダミー(dev-only-)。実運用の秘密情報をこのファイルや deployment.yaml に書かないこと
# (不変条件6)。LibreChat 固有の値は librechat/librechat.env.example。

# Gateway がトークンのイントロスペクションに使う Keycloak クライアント gateway の secret。
# realm(e2e/keycloak/realm/kp-realm.json)に書かれた値と一致させる
KP_KEYCLOAK_CLIENT_SECRET=dev-only-gateway-secret

# ソース dev-docs(開発用コネクタ)に渡す本人資格情報のモック(auth.provider: mock_env)
KP_MOCK_TOKEN_DEV_DOCS=dev-only-token

# Keycloak(開発モード)の管理者 admin の初期パスワード
KC_BOOTSTRAP_ADMIN_PASSWORD=dev-only-admin-password

# Gateway の run API(ADR-019)の runId 署名鍵(deployment.yaml の gateway.runs.signingKeyEnv)。
# 32 バイト以上の乱数を hex / base64 / base64url で。Gateway だけが持つ。この値は公開済みの開発用の
# 例(packages/gateway の DEV_RUN_ID_KEY_EXAMPLE)で、NODE_ENV=production では起動を拒否される。
# 生成例: openssl rand -base64 32
KP_RUN_ID_KEY=dev-only-run-id-signing-key-not-for-production-00001

# Gateway と Orchestrator(kp-ask serve)が共有する Orchestrator の資格情報
# (gateway.runs.orchestratorCredentialEnv)。16 文字以上。gateway と orchestrator の両方に同じ値を
# 渡す。この値は開発用の既定値(DEV_ORCHESTRATOR_CREDENTIAL)で、NODE_ENV=production では拒否される。
# 生成例: openssl rand -base64 32
KP_ORCHESTRATOR_CREDENTIAL=dev-only-orchestrator-credential

# Gateway の run API が引用の docId をハッシュ化する HMAC 鍵(deployment.yaml の
# audit.privateScopeDocIds: hashed、audit.docIdHmacKeyEnv。デプロイ固有の秘密)
KP_AUDIT_HMAC_KEY=dev-only-audit-hmac-key

# ---- LibreChat overlay(docker-compose.librechat.yml)で使う。基本の構成だけなら不要 ----

# LLM(OpenAI 互換 API)。既定はホストの LM Studio(コンテナからは host.docker.internal)。
# 秘密ではない設定値。KP_LLM_MODEL は LM Studio でロードしたモデル名に合わせる
# (curl http://localhost:1234/v1/models の id。ツール呼び出しに対応したモデル)
KP_LLM_BASE_URL=http://host.docker.internal:1234/v1
KP_LLM_MODEL=openai/gpt-oss-20b
